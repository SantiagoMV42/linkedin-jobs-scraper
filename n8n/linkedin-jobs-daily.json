{
  "name": "Daily LinkedIn job alert (Apify)",
  "nodes": [
    {
      "parameters": {
        "rule": { "interval": [{ "field": "days", "triggerAtHour": 8 }] }
      },
      "name": "Every day at 08:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.apify.com/v2/acts/santiagomv~linkedin-jobs/run-sync-get-dataset-items",
        "sendQuery": true,
        "queryParameters": { "parameters": [{ "name": "token", "value": "YOUR_APIFY_TOKEN" }] },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{\n  \"searchQueries\": [\"data engineer\"],\n  \"location\": \"United States\",\n  \"datePosted\": \"day\",\n  \"maxJobsPerSearch\": 50,\n  \"onlyNewJobs\": true\n}",
        "options": { "timeout": 300000 }
      },
      "name": "Scrape new LinkedIn jobs",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [240, 0]
    }
  ],
  "connections": {
    "Every day at 08:00": { "main": [[{ "node": "Scrape new LinkedIn jobs", "type": "main", "index": 0 }]] }
  },
  "settings": {}
}
